---
import OpinionCard from "./OpinionCard.astro"
---

<section id="testimonios" class="flex flex-col items-center py-10 gap-5">
    <p class="bg-(--azulBadge) text-(--azulPrincipal) py-2 px-3 rounded-2xl text-sm font-semibold tracking-wider w-fit">TESTIMONIOS</p>
    <h2 class="text-4xl text-center p-2">Lo que dicen nuestros pacientes</h2>
    <p class="text-(--textoSecundario) text-center max-w-3xl px-4">Pacientes que confían en Sonrisa Perfecta para mejorar su sonrisa con tratamientos dentales de calidad.</p>
    <section class="w-full flex flex-row items-center justify-center flex-wrap gap-10 mb-10">
        <OpinionCard img="/paciente.jpg" text="Excelente atención, mi sonrisa quedó increible." nombre="María López">
        </OpinionCard>
        <OpinionCard img="/paciente.jpg" text="La clínica tiene equipos modernos y el trato fue excelente." nombre="Carlos Ramírez">
        </OpinionCard>
        <OpinionCard img="/paciente.jpg" text="Muy recomendados. Todo el personal fue amable y atento." nombre="Andrea Torres">
        </OpinionCard>
    </section>
</section>