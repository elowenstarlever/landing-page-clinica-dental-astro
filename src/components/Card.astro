---
const { titulo, text } = Astro.props;
---

<div class="w-75 shadow-md  border border-(--bordes) rounded-2xl py-10 px-10 flex flex-col items-center">
    <div class="p-5">
        <slot />
    </div>
    <p class="font-bold">{titulo}</p>
    <p class="mt-3 text-(--textoSecundario) text-center">
        {text}
    </p>
</div>